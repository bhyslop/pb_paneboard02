# The substrate's own suite — plain rust hurdles that spawn bash and judge it from
# outside the dying process.
#
# NO APP COLLAR STANDS BESIDE THIS ONE, and for a plainer reason than at the
# kennel: this crate builds no binary at all. The substrate is bash, and what is
# compiled here is its self-test and nothing else.

BKRR_COLLAR="bun_suite"
BKRR_KIND="bknre_suite"
BKRR_MANIFEST="Tools/buk/Cargo.toml"
BKRR_TARGET="bknre_manifest"

# THE KIT'S RUST SIDE AND THE KENNEL WHOLE, and the kennel is named WHOLE
# deliberately where the other collars carve its test modules back out.
#
# Those carve-outs rest on one sentence: a bkt* module compiles only under test,
# so a crate depending on the kennel is not compiled from any of them. That
# sentence is FALSE HERE. This suite composes its seats through the kennel's
# composing surface, which stands at Tools/bkk/bk0/src/bktu_lure.rs and is published
# under the kennel's `lure` feature exactly so a second suite can reach it — so
# one module beneath that glob IS compiled into what this collar declares, and a
# collar taking the usual exclusion would declare a closure this crate does not
# have.
#
# The remaining bkt* modules are over-elected by naming the directory whole, and
# the asymmetry is what settles it: over-election costs a position that moves when
# it need not, and under-election costs a position that stands still when it must
# move. Only one of those two can put a stale reading behind a green verdict.
#
# The bash surface of both kits stays out, none of it being compiled. The reader's
# own test modules are carved out on the untouched footing: they are declared
# under test, this crate does not reach them, and nothing here publishes one.
BKRR_ROOTS="Tools/buk/src \
  Tools/buk/tests \
  Tools/buk/Cargo.toml \
  Tools/buk/Cargo.lock \
  Tools/bkk \
  Tools/bkk/bk0/bkl \
  :(exclude)Tools/bkk/bk0/bkl/src/bklt*"

BKRR_FEATURES=""
BKRR_PROFILE="test"
BKRR_SPEND="bknre_reader"

# ONE DIRECT DEPENDENCY AND NO EXTERNAL CRATE. The kennel is named because the
# allow list names EVERY direct dependency, local and external alike — a sibling
# kit's crate is as much a link as a registry crate is. The regime reader rides in
# transitively behind it and is not named here, this list being the DIRECT edges;
# the roots above are what must reach it, and they do.
BKRR_TAMED_CRATES="bkk"

# Nothing feral in this closure; the field is asked at every collar
# (BKSCL-Collar.adoc "The tamed and the feral").
BKRR_FERAL_CRATES="bknre_tamed"

# The repository root. A muzzle is the governance of the tree being linted and
# travels with that tree, never with the kit reading it.
BKRR_MUZZLE="."

# CARGO'S OWN RUNNER, matching the kennel's own suite. The kennelman drives this
# crate beside the kennel's, and a collar naming a runner the kennelman does not
# spawn would make the two doors answer different questions of one suite.
BKRR_RUNNER="bknre_cargo"
BKRR_TONGUE="bknre_harness"

# NO GENERATED SOURCE STANDS IN THIS COMPILE. Declared rather than left silent:
# a door reading "nothing is generated here" out of an ABSENCE cannot tell a
# declaration from an omission, which is the distinction the validate door
# exists to draw.
BKRR_EXERGUE="bknre_unstruck"
